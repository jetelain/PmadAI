<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Pmad.AI.LlamaSharp</RootNamespace>
    <Authors>Julien Etelain</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Microsoft.Extensions.AI adapter for local LLamaSharp (llama.cpp) inference, supporting streaming, multimodal vision, tool calling, and open-weights chat formatting.</Description>
    <PackageProjectUrl>https://github.com/jetelain/PmadAI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jetelain/PmadAI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pmad.AI\Pmad.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pmad.AI.LlamaSharp.Tests" />
    <InternalsVisibleTo Include="Pmad.AI.Benchmark" />
  </ItemGroup>
</Project>