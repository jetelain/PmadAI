<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Pmad.AI</RootNamespace>
    <Authors>Julien Etelain</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Core AI utilities and protocol transforms for .NET, including tool-call payload healing, argument JSON sanitization, and zero-allocation heuristic token estimation.</Description>
    <PackageProjectUrl>https://github.com/jetelain/PmadAI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jetelain/PmadAI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pmad.AI.Tests" />
    <InternalsVisibleTo Include="Pmad.AI.MicroBenchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pmad.AI.SourceGenerators\Pmad.AI.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <None Include="..\Pmad.AI.SourceGenerators\bin\$(Configuration)\netstandard2.0\Pmad.AI.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>
</Project>
