<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Pmad.AI.DiffGuard.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>diffguard</ToolCommandName>
    <PackageId>Pmad.AI.DiffGuard</PackageId>
    <Version>0.1.0-preview</Version>
    <Authors>Julien Etelain</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Git diff security, supply-chain, blast-radius, and cross-model LLM judge CLI guardrail tool.</Description>
    <PackageProjectUrl>https://github.com/jetelain/PmadAI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jetelain/PmadAI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>git;diff;security;guardrails;sarif;llm-judge;ollama;openai;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <PackageReference Include="OllamaSharp" Version="5.5.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pmad.AI\Pmad.AI.csproj" />
  </ItemGroup>

</Project>
